# Meta Model API — https://dev.meta.ai → API keys
MODEL_API_KEY=

# Backend: mock (default, self-contained, synthetic data) or kedd (private platform adapter)
BACKEND=mock
# Which synthetic business the mock backend seeds: butik (products) or salon (services + appointments)
MOCK_BUSINESS=butik
# KEDD agent gateway (signed requests; see app/tools/backend.py KeddBackend)
# KEDD_API_URL=
# KEDD_AGENT_SECRET=
# MERCHANT_PHONE=+905XXXXXXXXX

# Models (Standard mode; content is not used for training)
# ORCHESTRATOR_MODEL=muse-spark-1.3
# VISION_MODEL=muse-spark-1.3
# IMAGE_MODEL=muse-image-1.0
# SAM_MODEL=sam-3.1
# ASR_MODEL=muse-voice-transcribe-1.0

# Guard-rails enforced in code
# MAX_DISCOUNT_PCT=70
# MAX_CAMPAIGN_RECIPIENTS=500
# REASONING_EFFORT=medium
